# Google Maps. Requis pour la carte et l'optimisation des trajets.
# La clé serveur (sinon la clé publique) géocode aussi les appels NetSuite.
# Résultat en cache mémoire. Sans clé, ville et région suffisent.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# NetSuite TBA (sandbox). Laisser vide : Dispatch v2 reste sur le CSV de démo.
# Realm = NETSUITE_ACCOUNT_ID tel quel, par exemple 9394021_SB1.
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# Écriture des tâches. Seule la valeur true active POST /api/netsuite/dispatch.
NETSUITE_WRITE_ENABLED=
